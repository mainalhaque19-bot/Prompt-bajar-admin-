rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Data Collections (Public Read)
    match /prompts/{promptId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email == 'mainalhaque19@gmail.com';
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email == 'mainalhaque19@gmail.com';
    }

    // 2. Admin Logic (Self or Owner)
    match /admins/{userId} {
      allow get: if request.auth != null && (request.auth.uid == userId || request.auth.token.email == 'mainalhaque19@gmail.com');
      allow list, write: if request.auth != null && request.auth.token.email == 'mainalhaque19@gmail.com';
    }

    // 3. Fallback
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
